{
  "kind": "alertPolicy",
  "displayName": "Circuit ${ENV}: site or API down",
  "documentation": {"mimeType": "text/markdown", "content": "An uptime check has failed from more than one place for 2 minutes. Open RUNBOOK.md, section \"Site or API is down\" (start with `make smoke`)."},
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "API /ready failing",
      "conditionThreshold": {
        "filter": "metric.type=\"monitoring.googleapis.com/uptime_check/check_passed\" AND resource.type=\"uptime_url\" AND resource.labels.host=\"${API_HOST}\"",
        "aggregations": [{"alignmentPeriod": "1200s", "perSeriesAligner": "ALIGN_NEXT_OLDER", "crossSeriesReducer": "REDUCE_COUNT_FALSE", "groupByFields": ["resource.label.host"]}],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 1,
        "duration": "120s",
        "trigger": {"count": 1}
      }
    },
    {
      "displayName": "App down",
      "conditionThreshold": {
        "filter": "metric.type=\"monitoring.googleapis.com/uptime_check/check_passed\" AND resource.type=\"uptime_url\" AND resource.labels.host=\"${APP_HOST}\"",
        "aggregations": [{"alignmentPeriod": "1200s", "perSeriesAligner": "ALIGN_NEXT_OLDER", "crossSeriesReducer": "REDUCE_COUNT_FALSE", "groupByFields": ["resource.label.host"]}],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 1,
        "duration": "120s",
        "trigger": {"count": 1}
      }
    },
    {
      "displayName": "Landing site down",
      "conditionThreshold": {
        "filter": "metric.type=\"monitoring.googleapis.com/uptime_check/check_passed\" AND resource.type=\"uptime_url\" AND resource.labels.host=\"${LANDING_HOST}\"",
        "aggregations": [{"alignmentPeriod": "1200s", "perSeriesAligner": "ALIGN_NEXT_OLDER", "crossSeriesReducer": "REDUCE_COUNT_FALSE", "groupByFields": ["resource.label.host"]}],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 1,
        "duration": "120s",
        "trigger": {"count": 1}
      }
    }
  ],
  "alertStrategy": {"autoClose": "1800s"},
  "notificationChannels": ${CHANNELS},
  "enabled": true
}
