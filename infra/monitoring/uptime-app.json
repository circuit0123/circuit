{
  "kind": "uptimeCheck",
  "displayName": "Circuit ${ENV} app home page",
  "monitoredResource": {"type": "uptime_url", "labels": {"project_id": "${PROJECT}", "host": "${APP_HOST}"}},
  "httpCheck": {"path": "/", "port": 443, "useSsl": true, "validateSsl": true, "requestMethod": "GET"},
  "period": "60s",
  "timeout": "10s"
}
