# Copy to .env (gitignored). Every variable is listed; notes say what differs per environment.
# Missing required variables make the app refuse to start.

ENV=dev                         # dev | demo | staging | production
DEBUG=true                      # dev only; the app refuses DEBUG=true in demo, staging and production
SECRET_KEY=change-me-to-50-random-chars   # dev only. Demo/staging/prod refuse to start unless it is random, 32+ chars: python -c "import secrets; print(secrets.token_urlsafe(50))"
DATABASE_URL=postgres://circuit:circuit@localhost:5432/circuit_dev   # staging/prod: Supabase pooler URL
REDIS_URL=redis://localhost:6379/0          # demo/staging/prod: Upstash

# URLs (PRODUCTION.md §2a): nothing hard-codes a domain
APP_URL=http://localhost:3000
LANDING_URL=http://localhost:3001
API_URL=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1           # prod: api.<domain>
CORS_ALLOWED_ORIGINS=http://localhost:3000  # prod: APP_URL only
CORS_PREVIEW_REGEX=                         # staging only; must start ^https:// and end $. Add your Vercel team slug: ^https://circuit-app-staging-git-[a-z0-9-]+-<team>\.vercel\.app$
CSRF_TRUSTED_ORIGINS=                       # admin form posts: the API origin

# Auth
DEMO_AUTH=true                  # dev/demo only; the app refuses to start with true in staging/production
DEMO_PUBLIC=false               # demo only: persona switcher open to visitors
SUPABASE_URL=                   # required in staging/production; must be https:// outside dev
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALG=ES256          # ES256 (default) | RS256; enable asymmetric JWT signing keys in each Supabase project
ADMIN_PATH=circuit-admin-x7k2/  # non-obvious admin URL; admin is not mounted when ENV=demo

# LLM (free tiers in dev/demo/staging only; production: paid tier that excludes training)
LLM_PROVIDER=groq               # gemini | groq | anthropic
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDING_PROVIDER=fake         # fastembed | fake (fake = offline, deterministic; use fastembed on staging/prod)

# Email
EMAIL_BACKEND=console           # console (dev) | disabled (demo) | resend (staging/prod)
EMAIL_FROM=Circuit <onboarding@resend.dev>
SUPPORT_EMAIL=support@example.com
RESEND_API_KEY=

# Seed data
SEED_CITY_NAME=Chennai
SEED_CITY_LAT=13.0827
SEED_CITY_LNG=80.2707

LOG_LEVEL=INFO

# Storage (build-log and chat images). Local files in dev; Supabase Storage elsewhere.
STORAGE_PROVIDER=local          # local (dev only) | supabase (required in staging/production)
SUPABASE_SERVICE_ROLE_KEY=      # backend only, never in Vercel: signs uploads/reads and broadcasts chat events
