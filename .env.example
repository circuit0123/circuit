# Copy to .env (gitignored). Every variable is listed; notes say what differs per environment.
# Missing required variables make the app refuse to start.

ENV=dev                         # dev | demo | staging | production
DEBUG=true                      # dev only; the app refuses DEBUG=true in demo, staging and production
SECRET_KEY=change-me-to-50-random-chars   # dev only. Demo/staging/prod refuse to start unless it is random, 32+ chars: python -c "import secrets; print(secrets.token_urlsafe(50))"
DATABASE_URL=postgres://circuit:circuit@localhost:5432/circuit_dev   # staging/prod: Supabase pooler URL
REDIS_URL=redis://localhost:6379/0          # demo/staging/prod: Upstash

# URLs (PRODUCTION.md §2a): nothing hard-codes a domain
APP_URL=http://localhost:3000
LANDING_URL=http://localhost:3001
API_URL=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1           # prod: api.<domain>
CORS_ALLOWED_ORIGINS=http://localhost:3000  # prod: APP_URL only
CORS_PREVIEW_REGEX=                         # staging only; must start ^https:// and end $. Add your Vercel team slug: ^https://circuit-app-staging-git-[a-z0-9-]+-<team>\.vercel\.app$
CSRF_TRUSTED_ORIGINS=                       # admin form posts: the API origin

# Auth
DEMO_AUTH=true                  # dev/demo only; the app refuses to start with true in staging/production
DEMO_PUBLIC=false               # demo only: persona switcher open to visitors
SUPABASE_URL=                   # required in staging/production; must be https:// outside dev
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALG=ES256          # ES256 (default) | RS256; enable asymmetric JWT signing keys in each Supabase project
ADMIN_PATH=circuit-admin-x7k2/  # non-obvious admin URL; admin is not mounted when ENV=demo

# LLM (free tiers in dev/demo/staging only; production: paid tier that excludes training)
LLM_PROVIDER=groq               # gemini | groq | anthropic
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDING_PROVIDER=fake         # fastembed | fake (fake = offline, deterministic; use fastembed on staging/prod)

# Email
EMAIL_BACKEND=console           # console (dev) | disabled (demo) | resend (staging/prod)
EMAIL_FROM=Circuit <onboarding@resend.dev>
SUPPORT_EMAIL=support@example.com
RESEND_API_KEY=                 # required when EMAIL_BACKEND=resend. Production also refuses the @resend.dev test sender in EMAIL_FROM

# Seed data
SEED_CITY_NAME=Chennai
SEED_CITY_LAT=13.0827
SEED_CITY_LNG=80.2707

LOG_LEVEL=INFO

# Error tracking (Sentry). Empty = off. Production: a secret (`make secret NAME=SENTRY_DSN`). Names, emails, phones, tokens and request
# bodies are removed before anything is sent (core/monitoring.py).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# RELEASE is set by the deploy script to the git tag of the image; leave empty locally.
RELEASE=
# Free-tier guards (PRODUCTION.md §11, RUNBOOK.md "A free-tier limit is nearly hit"). All optional; the defaults suit a laptop.
# LLM_PROVIDER also accepts "none": no language model at all, onboarding uses the manual pickers (no API key needed).
LLM_DAILY_CALL_LIMIT=0          # provider calls per India day, all instances together; past it: manual pickers. 0 = no cap
REDIS_LEAN=false                # true on Upstash's free plan: keep fewer copies in Redis (core/cache). The deploy files set it for cloud
REDIS_LEAN_MAX_TTL=600          # seconds an essential entry may live in lean mode
MEDIA_WEBP_QUALITY=82           # uploaded images; 75 in the cloud (Supabase free storage is 1 GB)
EMAIL_DAILY_BUDGET=90           # Resend free plan: 100 a day / 3,000 a month. Past the BUDGET, notification emails are in-app only;
EMAIL_MONTHLY_BUDGET=2800       # past the LIMIT, even invites and exports wait for tomorrow. 0 = no limit (paid plan)
EMAIL_DAILY_LIMIT=100
EMAIL_MONTHLY_LIMIT=3000
FREE_TIER_LIMITS=               # JSON overriding the limits the weekly usage report uses, e.g. {"database_bytes": 8589934592} on Supabase Pro

# Backups (core/backup.py, `make backup-now`). Empty bucket = files go to backend/.backups/ on a laptop. In production: BACKUP_BUCKET is set by the
# deploy script, BACKUP_DATABASE_URL is a secret (`make secret NAME=BACKUP_DATABASE_URL`: Supabase SESSION pooler or direct address, NOT port 6543),
# and BACKUP_AGE_RECIPIENT is the PUBLIC key from `age-keygen -o backup.key` (never the private key; that stays offline).
BACKUP_BUCKET=
BACKUP_DATABASE_URL=
BACKUP_AGE_RECIPIENT=
# Job health: how often each scheduled job should succeed, in minutes ("compute_matches:1440,expire_items:5"). Written by scripts/gcp.py
# from deploy/gcp/app.toml; empty locally, where nothing is expected to run on a schedule.
JOB_INTERVALS=

# Feature flags (CLAUDE.md "Feature flags", PRODUCTION.md §2b): default audience per flag, off | testers | everyone.
# Unlisted flags are off. promotions needs pulse; payments needs promotions. Super admins override in Django admin.
# dev/demo/staging: everything on. production at beta start: pulse + daily_drop everyone, circuits testers, rest off.
FEATURES=pulse:everyone,daily_drop:everyone,circuits:everyone,investor_mode:everyone,partner_mode:everyone,promotions:everyone,payments:everyone
BETA_MODE=false                 # invite-only beta gate (Stage 4b); off in dev/demo, on in staging (to test the gate) and in production until public launch
INVITES_PER_MEMBER=3            # invite codes each beta member can hand out; raising it tops everyone up on their next visit
TRUSTED_PROXY_HOPS=0            # proxies that append to X-Forwarded-For, for per-IP rate limits. dev: 0. Cloud Run (staging/production): 1; the app refuses 0 there
RAZORPAY_KEY_ID=                # rzp_test_... in dev/demo/staging; rzp_live_... only in production (refused elsewhere)

# Privacy and legal (Stage 7). POLICY_VERSION: bump it when the privacy policy or terms change and everyone is asked to accept again.
POLICY_VERSION=2026-01
GRIEVANCE_OFFICER_NAME=<GRIEVANCE_OFFICER>   # DPDP grievance contact, shown by GET /api/support/contact. Fill in before real users (lawyer)
GRIEVANCE_EMAIL=grievance@example.com
GRIEVANCE_ADDRESS=<ADDRESS>

# Storage (build-log and chat images). Local files in dev; Supabase Storage elsewhere.
STORAGE_PROVIDER=local          # local (dev only) | supabase (required in staging/production)
SUPABASE_SERVICE_ROLE_KEY=      # backend only, never in Vercel: signs uploads/reads and broadcasts chat events

# Frontends (PRODUCTION.md §2a): build-time variables, set per Vercel project. Local defaults shown.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_LANDING_URL=http://localhost:3001
NEXT_PUBLIC_BASE_PATH=          # app: path prefix when served under the landing domain (vercel.json uses /app); empty locally. If set, NEXT_PUBLIC_APP_URL must include it, e.g. https://<domain>/app
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_JOIN_LIVE=false     # landing: false = every call to action opens the waitlist form; true = links to APP_URL/join. Turn on after the app ships /join and is deployed
NEXT_PUBLIC_LAUNCH_MODE=live    # landing: live (default) = JOIN_LIVE decides; waitlist = pre-launch: every call to action and the waitlist section open NEXT_PUBLIC_WAITLIST_URL?role=…&src=…, no links to the app
NEXT_PUBLIC_WAITLIST_URL=       # landing: the external waitlist form (absolute https URL); required when LAUNCH_MODE=waitlist. Its hidden fields read ?role and ?src
NEXT_PUBLIC_CONTACT_EMAIL=      # landing footer "Contact" link; left out when empty
NEXT_PUBLIC_COMPANY_LEGAL_NAME= # landing footer company name; left out when empty
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_ENV=dev             # dev | demo | staging | production (drives the banner and the persona switcher)

# Frontend (apps/app, apps/landing): build-time public variables, see PRODUCTION.md §2a.
# Put them in apps/app/.env.local for local work.
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_ENV=dev                 # dev | demo | staging | production (dev tools only in dev and demo)

# Production on Google Cloud (PRODUCTION.md, deploy/gcp/*.toml). Everything above is read by the app in every environment.
DATABASE_POOLER=direct          # direct | transaction. transaction = Supabase's transaction pooler (port 6543), which Cloud Run needs: switches off server-side cursors. The app refuses port 6543 with "direct"
# Read by the production container only (docker/backend/Dockerfile, backend/circuit/gunicorn.py); leave unset on a laptop:
# PORT=8080                     # set by Cloud Run itself; gunicorn listens on it
# WEB_CONCURRENCY=2             # gunicorn worker processes. workers x GUNICORN_THREADS must equal the Cloud Run concurrency in deploy/gcp/app.toml (8)
# GUNICORN_THREADS=4
# FASTEMBED_CACHE_PATH=/app/models   # where the embedding model is baked into the image
# GOOGLE_CLOUD_PROJECT=         # set by deploy/gcp: lets log lines link to Cloud Trace
#
# Which of the variables above are SECRETS in production (stored in Google Secret Manager, never in a file or the image):
#   SECRET_KEY, DATABASE_URL, REDIS_URL, SUPABASE_SERVICE_ROLE_KEY, RESEND_API_KEY and the key of the LLM provider in use.
#   Set one with: make secret ENV=production NAME=SECRET_KEY   (deploy/gcp/app.toml lists them). Razorpay secrets join in Stage 4e.
