        "beta_mode": true,
        "env": "dev",
        "features": {
          "circuits": true,
          "daily_drop": true,
          "investor_mode": true,
          "partner_mode": true,
          "payments": true,
          "promotions": true,
          "pulse": true
        },
        "llm_available": true
      },
      "status": 200
    },
    {
      "hook": "useMe",
      "request": {
        "method": "GET",
        "path": "/api/me"
      },
      "response": {
        "allow_requests": true,
        "appearance": {
          "accent": "emerald",
          "swipe_tabs": true,
          "theme": "system"
        },
        "beta_access": false,
        "bio": "",
        "circuits_opt_in": false,
        "city": "",
        "college": "",
        "display_name": "",
        "has_needs_and_offers": false,
        "id": 301,
        "is_minor": false,
        "lat": null,
        "lng": null,
        "needs_consent": false,
        "open_intro_slots": 2,
        "organisation_id": null,
        "photo": null,
        "policy_version": "2026-01",
