    {
      "hook": "useHome",
      "request": {
        "method": "GET",
        "path": "/api/jobs"
      },
      "response": {
        "error": {
          "code": "beta_required",
          "details": null,
          "message": "Circuit is invite-only for now. Enter an invite code or join the waitlist."
        }
      },
      "status": 403
    },
    {
      "hook": "useRedeem",
      "request": {
        "body": {
          "code": "NOT-A-CODE"
        },
        "method": "POST",
        "path": "/api/beta/redeem"
      },
      "response": {
        "error": {
          "code": "invalid_code",
          "details": null,
          "message": "That code doesn't work. Check it and try again."
        }
      },
      "status": 400
    },
    {
      "hook": "useJoinWaitlist",
      "request": {
        "body": {
          "city": "Chennai",
          "college": "SVIT",
          "email": "meera@example.org",
          "note": "",
          "role": "student",
          "src": "landing-students"
        },
        "method": "POST",
        "path": "/api/waitlist"
      },
      "response": {
        "status": "ok"
      },
      "status": 202
    }
  ],
  "persona": "custom",
  "scenario": "beta_gate",
  "screen": "access"
}
