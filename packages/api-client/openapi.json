{
  "components": {
    "schemas": {
      "DemoToken": {
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "title": "Expires In",
            "type": "integer"
          }
        },
        "required": [
          "access_token",
          "expires_in"
        ],
        "title": "DemoToken",
        "type": "object"
      },
      "DepStatus": {
        "properties": {
          "jwks": {
            "title": "Jwks",
            "type": "string"
          },
          "postgres": {
            "title": "Postgres",
            "type": "string"
          },
          "redis": {
            "title": "Redis",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "postgres",
          "redis",
          "jwks"
        ],
        "title": "DepStatus",
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Health",
        "type": "object"
      },
      "JoinIn": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "title": "JoinIn",
        "type": "object"
      },
      "MeOut": {
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "is_minor": {
            "title": "Is Minor",
            "type": "boolean"
          },
          "organisation_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Organisation Id"
          },
          "role": {
            "title": "Role",
            "type": "string"
          },
          "verification_level": {
            "title": "Verification Level",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "role",
          "display_name",
          "verification_level",
          "organisation_id",
          "is_minor"
        ],
        "title": "MeOut",
        "type": "object"
      },
      "OrgMemberOut": {
        "properties": {
          "college": {
            "title": "College",
            "type": "string"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "role": {
            "title": "Role",
            "type": "string"
          },
          "verification_level": {
            "title": "Verification Level",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "display_name",
          "role",
          "college",
          "verification_level"
        ],
        "title": "OrgMemberOut",
        "type": "object"
      },
      "OrgOut": {
        "properties": {
          "city": {
            "title": "City",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "join_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Join Code"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "city"
        ],
        "title": "OrgOut",
        "type": "object"
      },
      "PageParams": {
        "properties": {
          "limit": {
            "default": 20,
            "maximum": 100,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "default": 0,
            "minimum": 0,
            "title": "Offset",
            "type": "integer"
          }
        },
        "title": "PageParams",
        "type": "object"
      },
      "Page_OrgMemberOut_": {
        "properties": {
          "count": {
            "title": "Count",
            "type": "integer"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/OrgMemberOut"
            },
            "title": "Items",
            "type": "array"
          },
          "next_offset": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Offset"
          }
        },
        "required": [
          "items",
          "count"
        ],
        "title": "Page[OrgMemberOut]",
        "type": "object"
      },
      "Persona": {
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "key": {
            "title": "Key",
            "type": "string"
          },
          "role": {
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "key",
          "role",
          "display_name"
        ],
        "title": "Persona",
        "type": "object"
      },
      "PersonaChoice": {
        "properties": {
          "persona": {
            "title": "Persona",
            "type": "string"
          }
        },
        "required": [
          "persona"
        ],
        "title": "PersonaChoice",
        "type": "object"
      }
    },
    "securitySchemes": {
      "SupabaseAuth": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Circuit backend. Errors always use {error: {code, message, details}}; lists use {items, count, next_offset}.",
    "title": "Circuit API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/demo/personas": {
      "get": {
        "description": "Dev and demo only.",
        "operationId": "core_demo_personas",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Persona"
                  },
                  "title": "Response",
                  "type": "array"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "List demo personas",
        "tags": [
          "demo"
        ]
      }
    },
    "/api/demo/token": {
      "post": {
        "description": "Dev and demo only.",
        "operationId": "core_demo_token",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PersonaChoice"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoToken"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Get a demo token",
        "tags": [
          "demo"
        ]
      }
    },
    "/api/health": {
      "get": {
        "description": "Process is up. Touches no dependencies.",
        "operationId": "core_health_health",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Liveness",
        "tags": [
          "health"
        ]
      }
    },
    "/api/health/deps": {
      "get": {
        "description": "Checks Postgres, Redis and the Supabase JWKS (skipped when SUPABASE_URL is unset). Redis down is degraded, not failed, because Postgres is the source of truth.",
        "operationId": "core_health_deps",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DepStatus"
                }
              }
            },
            "description": "OK"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DepStatus"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Dependency health",
        "tags": [
          "health"
        ]
      }
    },
    "/api/me": {
      "get": {
        "description": "The signed-in member's own basics.",
        "operationId": "apps_accounts_api_me",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOut"
                }
              }
            },
            "description": "OK"
          }
        },
        "security": [
          {
            "SupabaseAuth": []
          }
        ],
        "summary": "Current member",
        "tags": [
          "accounts"
        ]
      }
    },
    "/api/organisations/join": {
      "post": {
        "description": "Join an organisation with its invite code. Students, founders, mentors and investors who are not already in one. Rate limited.",
        "operationId": "apps_organisations_api_join",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JoinIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrgOut"
                }
              }
            },
            "description": "OK"
          }
        },
        "security": [
          {
            "SupabaseAuth": []
          }
        ],
        "summary": "Join by code",
        "tags": [
          "organisations"
        ]
      }
    },
    "/api/organisations/join-by-email": {
      "post": {
        "description": "Joins the organisation that owns the domain of the email your sign-in provider verified. The email is read from your token, never from the request.",
        "operationId": "apps_organisations_api_join_by_email",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrgOut"
                }
              }
            },
            "description": "OK"
          }
        },
        "security": [
          {
            "SupabaseAuth": []
          }
        ],
        "summary": "Join by verified email domain",
        "tags": [
          "organisations"
        ]
      }
    },
    "/api/organisations/leave": {
      "post": {
        "description": "Partner admins cannot leave.",
        "operationId": "apps_organisations_api_leave",
        "parameters": [],
        "responses": {
          "204": {
            "description": "No Content"
          }
        },
        "security": [
          {
            "SupabaseAuth": []
          }
        ],
        "summary": "Leave my organisation",
        "tags": [
          "organisations"
        ]
      }
    },
    "/api/organisations/mine": {
      "get": {
        "description": "The organisation I belong to. 404 if none.",
        "operationId": "apps_organisations_api_mine",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrgOut"
                }
              }
            },
            "description": "OK"
          }
        },
        "security": [
          {
            "SupabaseAuth": []
          }
        ],
        "summary": "My organisation",
        "tags": [
          "organisations"
        ]
      }
    },
    "/api/organisations/mine/members": {
      "get": {
        "description": "Partner admins only. Lists members of their own organisation who chose to be visible to it.",
        "operationId": "apps_organisations_api_members",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_OrgMemberOut_"
                }
              }
            },
            "description": "OK"
          }
        },
        "security": [
          {
            "SupabaseAuth": []
          }
        ],
        "summary": "Opted-in members of my organisation",
        "tags": [
          "organisations"
        ]
      }
    },
    "/api/organisations/mine/members/{member_id}": {
      "delete": {
        "description": "Partner admins only. Removes a member from their own organisation; any other id is a 404.",
        "operationId": "apps_organisations_api_remove_member",
        "parameters": [
          {
            "in": "path",
            "name": "member_id",
            "required": true,
            "schema": {
              "title": "Member Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        },
        "security": [
          {
            "SupabaseAuth": []
          }
        ],
        "summary": "Remove a member",
        "tags": [
          "organisations"
        ]
      }
    }
  },
  "servers": []
}
